{
  "name": "pokedex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "fetch-data": "tsx scripts/fetch-pokemon-data.ts --skip-existing --no-sprites --no-gifs",
    "fetch-data:force": "tsx scripts/fetch-pokemon-data.ts --force --no-sprites --no-gifs",
    "fetch-sprites": "tsx scripts/fetch-pokemon-data.ts --sprites-only --skip-existing --sprites --gifs",
    "fetch-sprites:force": "tsx scripts/fetch-pokemon-data.ts --sprites-only --force --sprites --gifs"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
